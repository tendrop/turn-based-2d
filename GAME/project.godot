config_version=5

[application]

config/name="TurnBased 2D"
run/main_scene="uid://l1k5670ib4d3"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

SignalManager="*uid://bdjyx46vvgloy"
GameStateManager="*uid://r4c1klqth3lb"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="keep_height"

[file_customization]

folder_colors={
"res://_scripts/": "gray",
"res://assets/": "orange",
"res://scenes/": "blue",
"res://scenes/combat/subscenes/combat_ui/": "green"
}

